{
  "name": "please-hold",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "description": "An incremental game about wasting a scammer's time, and then his entire operation.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node tools/simulate.ts",
    "build:pages": "BASE_PATH=/please-hold/ vite build",
    "preview:pages": "BASE_PATH=/please-hold/ vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "break_infinity.js": "2.0.0",
    "nanostores": "1.0.1",
    "svelte": "5.39.11"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/node": "24.9.2",
    "svelte-check": "4.3.2",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vite-node": "3.2.4",
    "vitest": "3.2.4"
  }
}
